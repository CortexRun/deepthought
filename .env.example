# Copy to .env and fill in. Never commit .env.
APP_NAME="Deepthought API"
HOST=0.0.0.0
PORT=8000

# Ollama (LLM + embeddings)
OLLAMA_BASE_URL=http://localhost:11434

# PostgreSQL with pgvector
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=deepthought
PG_USER=deepthought
PG_PASSWORD=change-me

# Optional: read credentials from a .pgpass file instead of PG_* (entry index is 0-based)
# PGPASS_PATH=/home/you/.pgpass
# PGPASS_INDEX=0
